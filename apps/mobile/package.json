{
  "name": "@drivercopilot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@drivercopilot/types": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@rnmapbox/maps": "^10.1.30",
    "@sentry/react-native": "^6.3.0",
    "@supabase/supabase-js": "^2.49.4",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.2.0",
    "expo-constants": "~17.0.0",
    "expo-image-manipulator": "~13.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.0",
    "expo-location": "~18.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "posthog-react-native": "^3.3.4",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "zod": "^3.24.1",
    "@tanstack/react-query": "^5.62.0",
    "expo-haptics": "~14.0.0",
    "react-native-reanimated": "~3.16.0"
  },
  "devDependencies": {
    "@drivercopilot/config": "workspace:*",
    "@testing-library/react-native": "^12.9.0",
    "@types/geojson": "^7946.0.14",
    "@types/react": "~18.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ]
  }
}
