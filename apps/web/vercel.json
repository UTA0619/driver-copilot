{
  "buildCommand": "pnpm build",
  "outputDirectory": "out",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "DENY" },
        { "key": "X-XSS-Protection",         "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://apps.apple.com/app/driver-copilot/id000000000",
      "permanent": false
    },
    {
      "source": "/android",
      "destination": "https://play.google.com/store/apps/details?id=com.drivercopilot.app",
      "permanent": false
    }
  ]
}
