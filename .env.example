# ─── Driver Copilot — Environment Variables ───────────────────────────────────
# Copy to .env.local and fill in each value.
# NEVER commit .env.local to version control.
#
# Mobile (EAS secrets):  eas secret:create --scope project --name KEY --value VALUE
# Web (Vercel):          vercel env add KEY production

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-side only, never expose to client

# ── OpenAI (Supabase Edge Function secret) ────────────────────────────────────
# platform.openai.com/api-keys
# Set via: supabase secrets set OPENAI_API_KEY=sk-...
OPENAI_API_KEY=sk-...

# ── Mapbox ────────────────────────────────────────────────────────────────────
# account.mapbox.com/access-tokens
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1...
MAPBOX_SECRET_TOKEN=sk.eyJ1...    # EAS build-time only (downloads native SDK)

# ── RevenueCat ────────────────────────────────────────────────────────────────
# app.revenuecat.com → Apps → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# ── PostHog ───────────────────────────────────────────────────────────────────
# app.posthog.com → Project Settings
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Sentry ────────────────────────────────────────────────────────────────────
# sentry.io → Settings → Projects → Keys
EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ── App ───────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development   # development | staging | production
EAS_PROJECT_ID=<expo-project-id>  # from: eas init
