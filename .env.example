# ─── Supabase ────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to client

# ─── Vision API (stored in Supabase secrets for Edge Functions) ──
OPENAI_API_KEY=sk-...                              # used only in Edge Functions
# GEMINI_API_KEY=...                              # alternative if Gemini chosen in ADR-001

# ─── Mapbox ──────────────────────────────────────────────────
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1...

# ─── RevenueCat ──────────────────────────────────────────────
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# ─── PostHog ─────────────────────────────────────────────────
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Sentry ──────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ─── App Config ──────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development   # development | staging | production
